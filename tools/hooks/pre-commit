#!/bin/sh
# Auto-refresh generated files on every commit so they always match the content:
#   tools/prerender_home.py -> home static fallback baked into index.html
# The regenerated file is re-staged into the commit. Never blocks the commit:
# if the generator fails (e.g. bad JSON) it warns and lets the commit through.
#
# Activated via:  git config core.hooksPath tools/hooks
root="$(git rev-parse --show-toplevel)" || exit 0
cd "$root" || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

if python3 tools/prerender_home.py >/dev/null 2>&1; then
  git add index.html 2>/dev/null
  echo "↻ pre-commit: refreshed home prerender"
else
  echo "⚠ pre-commit: could not refresh index.html prerender (check tools/prerender_home.py) — committing anyway"
fi
exit 0
